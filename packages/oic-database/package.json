{
    "name":  "@oic/database",
    "version":  "0.0.0",
    "private":  true,
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "require":  "./dist/index.js",
                              "default":  "./dist/index.js"
                          }
                },
    "scripts":  {
                    "build":  "prisma generate --schema prisma/schema.prisma \u0026\u0026 tsc -p tsconfig.build.json",
                    "db:generate":  "prisma generate --schema prisma/schema.prisma",
                    "db:validate":  "prisma validate --schema prisma/schema.prisma",
                    "db:migrate:dev":  "prisma migrate dev --schema prisma/schema.prisma",
                    "db:migrate:deploy":  "prisma migrate deploy --schema prisma/schema.prisma",
                    "lint":  "eslint .",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "tsc -p tsconfig.json --noEmit"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.19.3"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.10.7",
                            "prisma":  "^6.19.3",
                            "typescript":  "^5.7.3"
                        }
}
