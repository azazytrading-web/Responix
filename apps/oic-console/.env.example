# Server-only settings. Never prefix these names with NEXT_PUBLIC_.
OIC_API_URL=http://127.0.0.1:4100
OI_PLATFORM_URL=http://localhost:3000
OIC_CONSOLE_OPERATOR_PASSWORD=replace-with-a-long-random-operator-password
OIC_CONSOLE_SESSION_SECRET=replace-with-at-least-32-random-bytes
OIC_CONSOLE_API_CREDENTIAL=replace-with-a-dedicated-OIC-platform-admin-service-credential
OIC_CONSOLE_RUNTIME_CREDENTIAL=replace-with-a-separate-OIC-runtime-test-service-credential
OIC_CONSOLE_RUNTIME_PRINCIPAL_ID=replace-with-the-matching-runtime-principal-uuid
