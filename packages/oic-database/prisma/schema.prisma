  editionId     String          @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  application   OicApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  edition       OicModelEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  @@unique([applicationId, editionId])
  @@index([applicationId, createdAt])
}

model OicIntelligenceProfile {
  id          String                          @id @default(uuid()) @db.Uuid
  profileKey  String                          @unique @db.VarChar(64)
  displayName String                          @db.VarChar(160)
  description String                          @default("") @db.VarChar(1000)
  source      OicIntelligenceProfileSource    @default(CUSTOM)
  lifecycle   OicIntelligenceProfileLifecycle @default(ACTIVE)
  createdAt   DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                        @updatedAt @db.Timestamptz(6)
  revisions   OicIntelligenceProfileRevision[]
  @@index([lifecycle, source, profileKey])
}

model OicIntelligenceProfileRevision {
  id                         String                @id @default(uuid()) @db.Uuid
  profileId                  String                @db.Uuid
  revision                   Int
  contextIntensity           Int                   @default(50)
  memoryIntensity            Int                   @default(0)
  retrievalIntensity         Int                   @default(0)
  reasoningIntensity         Int                   @default(50)
  toolsIntensity             Int                   @default(0)
  verificationIntensity      Int                   @default(50)
  synthesisIntensity         Int                   @default(50)
  efficiencyIntensity        Int                   @default(50)
  maxStages                   Int                   @default(8)
  maxProviderCalls            Int                   @default(3)
  maxToolCalls                Int                   @default(0)
  maxRetrievalQueries         Int                   @default(2)
  maxMemoryItems              Int                   @default(4)
  maxCandidates               Int                   @default(1)
  maxVerificationRounds       Int                   @default(1)
  maxContextTokens            Int                   @default(8192)
  maxExecutionMs              Int                   @default(60000)
  allowMemoryWrites           Boolean               @default(false)
  allowRevision               Boolean               @default(true)
