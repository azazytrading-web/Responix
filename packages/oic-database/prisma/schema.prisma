  createdAt                   DateTime              @default(now()) @db.Timestamptz(6)
  profile                     OicIntelligenceProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  modelRevisions              OicModelRevision[]
  @@unique([profileId, revision])
  @@index([profileId, revision])
}

model OicIntelligenceMemory {
