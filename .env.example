NODE_ENV=development
APP_ENV=local

API_PORT=4000
API_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
TRUST_PROXY=false
COMPRESSION_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

DATABASE_URL=postgresql://responix:responix_dev_password@localhost:5432/responix?schema=public
POSTGRES_DB=responix
POSTGRES_USER=responix
POSTGRES_PASSWORD=responix_dev_password

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-local-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-local-refresh-secret-at-least-32-characters

R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=responix-local
R2_PUBLIC_BASE_URL=https://example.r2.dev

AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
AI_ENABLED=true
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONTEXT_TOKENS=32000
AI_DEFAULT_DAILY_REQUEST_LIMIT=10000
AI_DEFAULT_MONTHLY_REQUEST_LIMIT=300000
AI_DEFAULT_DAILY_TOKEN_LIMIT=100000000
AI_DEFAULT_MONTHLY_TOKEN_LIMIT=3000000000
AI_DEFAULT_DAILY_COST_LIMIT=1000.000000
AI_DEFAULT_MONTHLY_COST_LIMIT=30000.000000
AI_DEFAULT_MAX_CONCURRENT_INVOCATIONS=50
AI_DEFAULT_MAX_QUEUE_DEPTH=100
AI_DEFAULT_MAX_CONTEXT_TOKENS=32000
AI_DEFAULT_MAX_OUTPUT_TOKENS=4096
AI_EXPECTED_OUTPUT_TOKENS=1024
AI_TOKEN_ESTIMATION_CHARACTERS_PER_TOKEN=4
AI_ESTIMATED_COST_PER_MILLION_TOKENS=10.000000
AI_QUEUE_WAIT_TIMEOUT_MS=5000
AI_QUEUE_POLL_INTERVAL_MS=50
AI_RESERVATION_TTL_MS=60000
AI_RUNTIME_RECOVERY_INTERVAL_MS=30000
AI_RUNTIME_RECOVERY_BATCH_SIZE=100
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com
AI_PROVIDER_ALLOWED_PORTS=443
AI_PROVIDER_DNS_TIMEOUT_MS=2000
AI_PROVIDER_CONNECTION_TIMEOUT_MS=5000
AI_PROVIDER_READ_TIMEOUT_MS=15000
AI_PROVIDER_MAX_RESPONSE_BYTES=1048576

OTEL_SERVICE_NAME=responix
LOG_LEVEL=info
