generator client {
  provider = "prisma-client-js"
  output   = "../generated/oic-client"
}

datasource db {
  provider          = "postgresql"
  url               = env("OIC_DATABASE_URL")
  shadowDatabaseUrl = env("OIC_SHADOW_DATABASE_URL")
}

enum OicLifecycleStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OicCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OicIdempotencyStatus {
  COMPLETED
  FAILED
  IN_PROGRESS
}

enum OicProviderConnectionScope {
  PLATFORM
  APPLICATION
  TENANT
}

enum OicProviderAuthStrategy {
  NONE
  BEARER
  API_KEY_HEADER
}

enum OicProviderHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
}

enum OicUpstreamModelSource {
  MANUAL
  DISCOVERY
}

enum OicCatalogLifecycle {
  ACTIVE
  DISABLED
  DEPRECATED
  ARCHIVED
}

enum OicCapabilityEvidenceStatus {
  SUPPORTED
  UNSUPPORTED
  UNKNOWN
}

enum OicCapabilityEvidenceSource {
  PROVIDER_DECLARED
  PLATFORM_CURATED
  OBSERVED
}

enum OicPricingEvidenceStatus {
  KNOWN
  UNKNOWN
}

enum OicModelLifecycle {
  DRAFT
  EXPERIMENTAL
  CANDIDATE
  CANARY
  PRODUCTION
  MAINTENANCE
  DEPRECATED
  RETIRED
}

enum OicIntelligenceProfileLifecycle {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum OicIntelligenceProfileSource {
  BUILTIN
  CUSTOM
}

enum OicMemoryKind {
  EPISODIC
  SEMANTIC
  PROCEDURAL
  SESSION
  APPLICATION
}

enum OicMemoryLifecycle {
  ACTIVE
  STALE
  SUPERSEDED
  CONFLICTED
  UNVERIFIED
  ARCHIVED
}

enum OicMemorySensitivity {
  PUBLIC
  INTERNAL
  SENSITIVE
  RESTRICTED
}

enum OicKnowledgeLifecycle {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum OicExecutionStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum OicModelVariantKind {
  EXTERNAL_PROVIDER
}

enum OicRuntimeBindingScope {
  PLATFORM
  APPLICATION
  TENANT
}

enum OicRuntimeBindingStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum OicProviderSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum OicProviderAttemptStatus {
  DISPATCHED
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum OicUsageEvidenceStatus {
  REPORTED
  PARTIAL
  UNKNOWN
}

enum OicEconomicRevisionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum OicEconomicAssessmentStatus {
  ASSESSED
  PARTIAL
  UNKNOWN
}

enum OicEconomicAssessmentKind {
  ORIGINAL
  REPLAY
}

enum OicCustomerRatingStrategy {
  OIU_RATE
  RESOURCE_RATE
  REQUEST
  TASK
  FEATURE
  TIERED
  INCLUDED_PLUS_OVERAGE
  FIXED_PLUS_VARIABLE
}

enum OicRatedUsageStatus {
  RATED
  NOT_RATED
  PARTIAL
  UNKNOWN_CONVERSION
}

enum OicCommercialAdjustmentKind {
  CREDIT
  REVERSAL
}

enum OicProviderCostEvidenceClass {
  INVOICE_AUTHORITATIVE
  PROVIDER_REPORTED
  DERIVED_FROM_AUTHORITATIVE_USAGE
  ESTIMATED
  UNKNOWN
}

enum OicPolicyRevisionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum OicPlanAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OicQuotaSubject {
  APPLICATION
  TENANT
  PRINCIPAL
  MODEL
  TIER
  CAPABILITY
}

enum OicQuotaWindow {
  LIFETIME
  UTC_DAY
  UTC_MONTH
  ROLLING
  CONTRACT_PERIOD
}

enum OicQuotaEnforcement {
  HARD
  SOFT
}

enum OicUnknownLiabilityRule {
  DENY
  HOLD_MAXIMUM
}

enum OicBudgetUnit {
  OIU
  CURRENCY
}

enum OicAdmissionStatus {
  SHADOW
  ADMITTED
  DENIED
  DISPATCHED
  SETTLED
  UNCERTAIN
  RELEASED
}

enum OicReservationState {
  HELD
  DISPATCHED
  SETTLING
  SETTLED
  UNCERTAIN
  RELEASED
}

enum OicUsagePostingKind {
  RESERVE
  CONSUME
  RELEASE
  ADJUST
}

model OicApplication {
  id                          String                                @id @default(uuid()) @db.Uuid
  key                         String                                @unique @db.VarChar(64)
  displayName                 String                                @db.VarChar(160)
  status                      OicLifecycleStatus                    @default(ACTIVE)
  createdAt                   DateTime                              @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                              @updatedAt @db.Timestamptz(6)
  tenants                     OicTenant[]
  externalReferences          OicTenantExternalReference[]
  principals                  OicServicePrincipal[]
  humanMemberships            OicHumanApplicationMembership[]
  reviewerSessions            OicReviewerSession[]
  reviewerAuthorizations      OicReviewerAuthorization[]
  reviewAssignments           OicReviewAssignment[]
  reviewCalibrations          OicReviewerCalibration[]
  reviewCalibrationPolicies   OicReviewCalibrationPolicy[]
  reviewAdjudications         OicReviewAdjudication[]
  reviewerQualifications      OicReviewerQualificationAttestation[]
  domainReviewBatches         OicDomainReviewBatch[]
  domainReviewAssignments     OicDomainReviewAssignment[]
  domainReviewConflictScopes  OicDomainReviewConflictScope[]
  adminRecoveryRecords        OicAdminRecoveryRecord[]
  operationalBootstrapRecords OicOperationalAdminBootstrapRecord[]
  providerConnections         OicProviderConnection[]
  runtimeBindings             OicRuntimeBinding[]
  modelVisibility             OicApplicationModelVisibility[]
  intelligenceMemories        OicIntelligenceMemory[]
  intelligenceKnowledge       OicIntelligenceKnowledge[]
  intelligenceExecutions      OicIntelligenceExecution[]
  providerAttempts            OicProviderAttempt[]
  providerRateBooks           OicProviderRateBookRevision[]
  oiuPolicies                 OicOiuPolicyRevision[]
  plans                       OicPlan[]
  planAssignments             OicPlanAssignment[]
  quotaPolicies               OicQuotaPolicyRevision[]
  budgetPolicies              OicBudgetRevision[]
  quotaBuckets                OicQuotaBucket[]
  admissions                  OicAdmission[]
  customerPriceBooks          OicCustomerPriceBookRevision[]
  ratedUsageEvents            OicRatedUsageEvent[]
  ratedUsageAdjustments       OicRatedUsageAdjustment[]
  customerAllowanceBuckets    OicCustomerAllowanceBucket[]
  evaluationPacks             OicEvaluationPackRevision[]
  evaluationValidationJobs    OicEvaluationValidationJob[]
  evaluationReleases          OicEvaluationRelease[]
  evaluationManifests         OicEvaluationProtocolManifest[]
  evaluationCampaigns         OicEvaluationCampaign[]
  evaluationCapacityExtensions OicEvaluationCapacityExtension[]
  evaluationRuns              OicEvaluationRun[]
  evaluationCandidates        OicEvaluationCandidate[]
  evaluationMetrics           OicEvaluationMetricRevision[]
  evaluationJudges            OicEvaluationJudgeRevision[]
  evaluationArtifacts         OicEvaluationArtifact[]
  evaluationBasisDrafts       OicEvaluationBasisDraft[]
  evaluationBasisBridges      OicEvaluationBasisBridgeRevision[]
  evaluationRegradePasses     OicEvaluationRegradePass[]
  evaluationDatasets          OicEvaluationDatasetRevision[]
  evaluationEnvironments      OicEvaluationEnvironmentRevision[]
  evaluationSuites            OicEvaluationSuiteRevision[]
  evaluationWorkItems         OicEvaluationWorkItem[]
  evaluationOutbox            OicEvaluationOutbox[]

  @@index([status, key])
}

model OicTenant {
  id                        String                             @id @default(uuid()) @db.Uuid
  applicationId             String                             @db.Uuid
  key                       String?                            @db.VarChar(64)
  displayName               String                             @db.VarChar(160)
  status                    OicLifecycleStatus                 @default(ACTIVE)
  createdAt                 DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                           @updatedAt @db.Timestamptz(6)
  application               OicApplication                     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  references                OicTenantExternalReference[]
  grants                    OicPrincipalTenantGrant[]
  humanMemberships          OicHumanApplicationMembership[]
  reviewerAuthorizations    OicReviewerAuthorization[]
  reviewAssignments         OicReviewAssignment[]
  reviewCalibrationPolicies OicReviewCalibrationPolicy[]
  reviewCalibrations        OicReviewerCalibration[]
  reviewAdjudications       OicReviewAdjudication[]
  providerConnections       OicProviderConnection[]
  runtimeBindings           OicRuntimeBinding[]
  intelligenceMemories      OicIntelligenceMemory[]
  intelligenceKnowledge     OicIntelligenceKnowledge[]
  intelligenceExecutions    OicIntelligenceExecution[]
  providerAttempts          OicProviderAttempt[]
  providerRateBooks         OicProviderRateBookRevision[]
  oiuPolicies               OicOiuPolicyRevision[]
  planAssignments           OicPlanAssignment[]
  quotaPolicies             OicQuotaPolicyRevision[]
  budgetPolicies            OicBudgetRevision[]
  quotaBuckets              OicQuotaBucket[]
  admissions                OicAdmission[]
  customerPriceBooks        OicCustomerPriceBookRevision[]
  ratedUsageEvents          OicRatedUsageEvent[]
  ratedUsageAdjustments     OicRatedUsageAdjustment[]
  customerAllowanceBuckets  OicCustomerAllowanceBucket[]
  evaluationPacks           OicEvaluationPackRevision[]
  evaluationValidationJobs  OicEvaluationValidationJob[]
  evaluationReleases        OicEvaluationRelease[]
  evaluationManifests       OicEvaluationProtocolManifest[]
  evaluationCampaigns       OicEvaluationCampaign[]
  evaluationCapacityExtensions OicEvaluationCapacityExtension[]
  evaluationRuns            OicEvaluationRun[]
  evaluationBasisDrafts     OicEvaluationBasisDraft[]
  evaluationBasisBridges    OicEvaluationBasisBridgeRevision[]
  evaluationRegradePasses   OicEvaluationRegradePass[]
  evaluationCandidates      OicEvaluationCandidate[]
  evaluationMetrics         OicEvaluationMetricRevision[]
  evaluationJudges          OicEvaluationJudgeRevision[]
  evaluationArtifacts       OicEvaluationArtifact[]
  evaluationDatasets        OicEvaluationDatasetRevision[]
  evaluationEnvironments    OicEvaluationEnvironmentRevision[]
  evaluationSuites          OicEvaluationSuiteRevision[]
  evaluationWorkItems       OicEvaluationWorkItem[]
  evaluationOutbox          OicEvaluationOutbox[]

  @@unique([id, applicationId])
  @@unique([applicationId, key])
  @@index([applicationId, status, createdAt])
}

model OicTenantExternalReference {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @db.Uuid
  tenantId      String         @db.Uuid
  sourceType    String         @db.VarChar(64)
  externalId    String         @db.VarChar(256)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  revokedAt     DateTime?      @db.Timestamptz(6)
  application   OicApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  tenant        OicTenant      @relation(fields: [tenantId, applicationId], references: [id, applicationId], onDelete: Restrict)

  @@unique([applicationId, sourceType, externalId])
  @@index([tenantId, createdAt])
}

model OicServicePrincipal {
  id                          String                               @id @default(uuid()) @db.Uuid
  applicationId               String                               @db.Uuid
  key                         String                               @db.VarChar(64)
  displayName                 String                               @db.VarChar(160)
  status                      OicLifecycleStatus                   @default(ACTIVE)
  createdAt                   DateTime                             @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                             @updatedAt @db.Timestamptz(6)
  application                 OicApplication                       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  scopes                      OicPrincipalScopeGrant[]
  tenantGrants                OicPrincipalTenantGrant[]
  credentials                 OicMachineCredential[]
  adminRecoveryRecords        OicAdminRecoveryRecord[]
  operationalBootstrapRecords OicOperationalAdminBootstrapRecord[]
  reviewerGrants              OicReviewerAuthorization[]
  providerAttempts            OicProviderAttempt[]
  admissions                  OicAdmission[]
  ratedUsageAdjustments       OicRatedUsageAdjustment[]

  @@unique([id, applicationId])
  @@unique([applicationId, key])
  @@index([applicationId, status])
}

model OicPrincipalScopeGrant {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  principalId   String              @db.Uuid
  scope         String              @db.VarChar(128)
  grantedBy     String?             @db.Uuid
  grantedAt     DateTime            @default(now()) @db.Timestamptz(6)
  revokedAt     DateTime?           @db.Timestamptz(6)
  principal     OicServicePrincipal @relation(fields: [principalId, applicationId], references: [id, applicationId], onDelete: Restrict)

  @@unique([principalId, scope])
  @@index([applicationId, scope, revokedAt])
}

model OicPrincipalTenantGrant {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  principalId   String              @db.Uuid
  tenantId      String              @db.Uuid
  grantedBy     String?             @db.Uuid
  grantedAt     DateTime            @default(now()) @db.Timestamptz(6)
  revokedAt     DateTime?           @db.Timestamptz(6)
  principal     OicServicePrincipal @relation(fields: [principalId, applicationId], references: [id, applicationId], onDelete: Restrict)
  tenant        OicTenant           @relation(fields: [tenantId, applicationId], references: [id, applicationId], onDelete: Restrict)

  @@unique([principalId, tenantId])
  @@index([applicationId, tenantId, revokedAt])
}

model OicMachineCredential {
  id                         String                              @id @default(uuid()) @db.Uuid
  principalId                String                              @db.Uuid
  selector                   String                              @unique @db.VarChar(32)
  verifier                   String                              @db.VarChar(256)
  verifierVersion            Int                                 @default(1)
  status                     OicCredentialStatus                 @default(ACTIVE)
  createdAt                  DateTime                            @default(now()) @db.Timestamptz(6)
  expiresAt                  DateTime?                           @db.Timestamptz(6)
  revokedAt                  DateTime?                           @db.Timestamptz(6)
  lastUsedAt                 DateTime?                           @db.Timestamptz(6)
  replacedById               String?                             @unique @db.Uuid
  principal                  OicServicePrincipal                 @relation(fields: [principalId], references: [id], onDelete: Restrict)
  replacedBy                 OicMachineCredential?               @relation("CredentialReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces                   OicMachineCredential?               @relation("CredentialReplacement")
  adminRecoveryRecord        OicAdminRecoveryRecord?
  operationalBootstrapRecord OicOperationalAdminBootstrapRecord?

  @@index([principalId, status, expiresAt])
}

model OicAuditEvent {
  id                   String            @id @default(uuid()) @db.Uuid
  occurredAt           DateTime          @default(now()) @db.Timestamptz(6)
  actorPrincipalId     String?           @db.Uuid
  actorHumanIdentityId String?           @db.Uuid
  actorType            String?           @db.VarChar(24)
  applicationId        String?           @db.Uuid
  tenantId             String?           @db.Uuid
  action               String            @db.VarChar(96)
  targetType           String            @db.VarChar(64)
  targetId             String?           @db.VarChar(128)
  requestId            String?           @db.VarChar(128)
  traceId              String?           @db.VarChar(128)
  metadata             Json              @default("{}") @db.JsonB
  humanActor           OicHumanIdentity? @relation(fields: [actorHumanIdentityId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([actorPrincipalId, occurredAt])
  @@index([targetType, targetId, occurredAt])
}

// Human reviewer identities are separate from OIC machine principals. Local
// credentials and sessions are stored as verifiers; only the API can resolve them.
model OicHumanIdentity {
  id                      String                                @id @default(uuid()) @db.Uuid
  displayLabel            String                                @db.VarChar(120)
  status                  String                                @default("ACTIVE") @db.VarChar(16)
  createdAt               DateTime                              @default(now()) @db.Timestamptz(6)
  disabledAt              DateTime?                             @db.Timestamptz(6)
  authSubjects            OicHumanAuthSubject[]
  memberships             OicHumanApplicationMembership[]
  authorizations          OicReviewerAuthorization[]
  sessions                OicReviewerSession[]
  assignments             OicReviewAssignment[]
  calibrations            OicReviewerCalibration[]
  adjudications           OicReviewAdjudication[]
  submissions             OicReviewSubmission[]
  auditEvents             OicAuditEvent[]
  qualifications          OicReviewerQualificationAttestation[]
  domainReviewAssignments OicDomainReviewAssignment[]
  domainReviewSubmissions OicDomainReviewSubmission[]

  @@index([status, createdAt])
}

model OicHumanAuthSubject {
  id                String               @id @default(uuid()) @db.Uuid
  humanIdentityId   String               @db.Uuid
  kind              String               @default("LOCAL") @db.VarChar(16)
  loginHandle       String?              @unique @db.VarChar(96)
  issuer            String?              @db.VarChar(512)
  subject           String?              @db.VarChar(256)
  verifier          String?              @db.VarChar(256)
  verifierVersion   Int                  @default(1)
  status            String               @default("ACTIVE") @db.VarChar(16)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  passwordChangedAt DateTime?            @db.Timestamptz(6)
  revokedAt         DateTime?            @db.Timestamptz(6)
  humanIdentity     OicHumanIdentity     @relation(fields: [humanIdentityId], references: [id], onDelete: Restrict)
  sessions          OicReviewerSession[]

  @@unique([issuer, subject])
  @@index([humanIdentityId, status])
}

model OicHumanApplicationMembership {
  id              String               @id @default(uuid()) @db.Uuid
  humanIdentityId String               @db.Uuid
  applicationId   String               @db.Uuid
  tenantId        String?              @db.Uuid
  status          String               @default("ACTIVE") @db.VarChar(16)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  revokedAt       DateTime?            @db.Timestamptz(6)
  humanIdentity   OicHumanIdentity     @relation(fields: [humanIdentityId], references: [id], onDelete: Restrict)
  application     OicApplication       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  tenant          OicTenant?           @relation(fields: [tenantId, applicationId], references: [id, applicationId], onDelete: Restrict)
  sessions        OicReviewerSession[]

  @@unique([humanIdentityId, applicationId, tenantId])
  @@index([applicationId, tenantId, status])
}

model OicReviewerAuthorization {
  id                   String              @id @default(uuid()) @db.Uuid
  humanIdentityId      String              @db.Uuid
  applicationId        String              @db.Uuid
  tenantId             String?             @db.Uuid
  capability           String              @db.VarChar(64)
  status               String              @default("ACTIVE") @db.VarChar(16)
  grantedByPrincipalId String              @db.Uuid
  grantedAt            DateTime            @default(now()) @db.Timestamptz(6)
  effectiveAt          DateTime            @default(now()) @db.Timestamptz(6)
  revokedAt            DateTime?           @db.Timestamptz(6)
  humanIdentity        OicHumanIdentity    @relation(fields: [humanIdentityId], references: [id], onDelete: Restrict)
  application          OicApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  tenant               OicTenant?          @relation(fields: [tenantId, applicationId], references: [id, applicationId], onDelete: Restrict)
  grantor              OicServicePrincipal @relation(fields: [grantedByPrincipalId], references: [id], onDelete: Restrict)

  @@unique([humanIdentityId, applicationId, tenantId, capability])
  @@index([applicationId, tenantId, capability, status])
}

model OicReviewerSession {
  id                      String                        @id @default(uuid()) @db.Uuid
  humanIdentityId         String                        @db.Uuid
  authSubjectId           String                        @db.Uuid
  membershipId            String                        @db.Uuid
  applicationId           String                        @db.Uuid
  tokenHash               String                        @unique @db.Char(64)
  createdAt               DateTime                      @default(now()) @db.Timestamptz(6)
  lastSeenAt              DateTime                      @default(now()) @db.Timestamptz(6)
  idleExpiresAt           DateTime                      @db.Timestamptz(6)
  expiresAt               DateTime                      @db.Timestamptz(6)
  revokedAt               DateTime?                     @db.Timestamptz(6)
  humanIdentity           OicHumanIdentity              @relation(fields: [humanIdentityId], references: [id], onDelete: Restrict)
  authSubject             OicHumanAuthSubject           @relation(fields: [authSubjectId], references: [id], onDelete: Restrict)
  membership              OicHumanApplicationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  application             OicApplication                @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  submissions             OicReviewSubmission[]
  domainReviewSubmissions OicDomainReviewSubmission[]

  @@index([humanIdentityId, revokedAt, expiresAt])
}

model OicReviewCalibrationPolicy {
  id                   String                   @id @default(uuid()) @db.Uuid
  applicationId        String                   @db.Uuid
  tenantId             String?                  @db.Uuid
  judgeRevisionId      String                   @db.Uuid
  revision             Int
  calibrationSetDigest String                   @db.Char(64)
  referenceArtifactId  String                   @db.Uuid
  minimumAnchors       Int
  minimumAgreement     Decimal                  @db.Decimal(6, 5)
  expiresAfterDays     Int
  status               String                   @default("PUBLISHED") @db.VarChar(16)
  createdByPrincipalId String                   @db.Uuid
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  application          OicApplication           @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  tenant               OicTenant?               @relation(fields: [tenantId, applicationId], references: [id, applicationId], onDelete: Restrict)
  referenceArtifact    OicEvaluationArtifact    @relation(fields: [referenceArtifactId], references: [id], onDelete: Restrict)
  attempts             OicReviewerCalibration[]

  @@unique([applicationId, tenantId, judgeRevisionId, revision], map: "OicReviewCalibrationPolicy_app_tenant_judge_rev_key")
  @@index([applicationId, tenantId, judgeRevisionId, status], map: "OicReviewCalibrationPolicy_app_tenant_judge_status_idx")
}

model OicReviewerCalibration {
  id              String                     @id @default(uuid()) @db.Uuid
  humanIdentityId String                     @db.Uuid
  applicationId   String                     @db.Uuid
  tenantId        String?                    @db.Uuid
  policyId        String                     @db.Uuid
  answers         Json                       @db.JsonB
  abstentions     Json                       @default("[]") @db.JsonB
  agreement       Decimal?                   @db.Decimal(6, 5)
  anchorCount     Int
  eligibility     String                     @db.VarChar(16)
  expiresAt       DateTime?                  @db.Timestamptz(6)
  supersedesId    String?                    @db.Uuid
  evidenceDigest  String                     @db.Char(64)
  completedAt     DateTime                   @default(now()) @db.Timestamptz(6)
  humanIdentity   OicHumanIdentity           @relation(fields: [humanIdentityId], references: [id], onDelete: Restrict)
  application     OicApplication             @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  tenant          OicTenant?                 @relation(fields: [tenantId, applicationId], references: [id, applicationId], onDelete: Restrict)
  policy          OicReviewCalibrationPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  supersedes      OicReviewerCalibration?    @relation("CalibrationSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    OicReviewerCalibration[]   @relation("CalibrationSupersession")

  @@index([humanIdentityId, applicationId, tenantId, completedAt])
}

// Owner-provided reviewer qualification claims are immutable, scoped records.
// They establish only the exact language and review-purpose claims recorded.
model OicReviewerQualificationAttestation {
  id                    String           @id @default(uuid()) @db.Uuid
  humanIdentityId       String           @db.Uuid
  applicationId         String           @db.Uuid
  qualificationKey      String           @db.VarChar(96)
  language              String           @db.VarChar(16)
  proficiency           String           @db.VarChar(24)
  isPrimaryLanguage     Boolean
  attestationSource     String           @db.VarChar(32)
  attestationDigest     String           @db.Char(64)
  attestedByPrincipalId String           @db.Uuid
  attestedAt            DateTime         @default(now()) @db.Timestamptz(6)
  humanIdentity         OicHumanIdentity @relation(fields: [humanIdentityId], references: [id], onDelete: Restrict)
  application           OicApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([humanIdentityId, applicationId, qualificationKey])
  @@index([applicationId, qualificationKey, language, proficiency])
}

model OicReviewAssignment {
  id                  String                @id @default(uuid()) @db.Uuid
  humanIdentityId     String                @db.Uuid
  applicationId       String                @db.Uuid
  tenantId            String?               @db.Uuid
  caseExecutionId     String                @db.Uuid
  protocolRevisionId  String                @db.Uuid
  judgeRevisionId     String                @db.Uuid
  metricRevisionId    String                @db.Uuid
  reviewMode          String                @default("PAIRWISE") @db.VarChar(24)
  blindedItemId       String                @db.VarChar(128)
  blindProjection     Json                  @db.JsonB
  blindMapping        Json                  @db.JsonB
  randomizedOrder     Json?                 @db.JsonB
  conflictState       String                @db.VarChar(16)
  conflictEvidence    Json                  @default("{}") @db.JsonB
  eligibilitySnapshot Json                  @db.JsonB
  status              String                @default("ASSIGNED") @db.VarChar(16)
  assignedAt          DateTime              @default(now()) @db.Timestamptz(6)
  openedAt            DateTime?             @db.Timestamptz(6)
  deadlineAt          DateTime?             @db.Timestamptz(6)
  reassignedAt        DateTime?             @db.Timestamptz(6)
