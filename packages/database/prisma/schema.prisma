model Plan {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  monthlyPrice Decimal   @map("monthly_price") @db.Decimal(14, 2)
  yearlyPrice  Decimal   @map("yearly_price") @db.Decimal(14, 2)
  maxUsers     Int       @default(0) @map("max_users")
  maxAgents    Int       @default(0) @map("max_agents")
  maxMessages  Int       @default(0) @map("max_messages")
  maxStorage   BigInt    @default(0) @map("max_storage")
  maxTokens    Int       @default(0) @map("max_tokens")
  featuresJson Json      @map("features_json")
  gracePeriodDays Int    @default(0) @map("grace_period_days")
  metadata     Json?     @map("metadata")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  activeForWorkspaces Workspace[]    @relation("WorkspacePlan")
  subscriptions       Subscription[]
  entitlements        PlanEntitlement[]

  @@index([active])
  @@map("plans")
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  billingCycle BillingCycle       @map("billing_cycle")
  status       SubscriptionStatus @default(TRIAL)
  startedAt    DateTime           @map("started_at")
  expiresAt    DateTime?          @map("expires_at")
  autoRenew    Boolean            @default(false) @map("auto_renew")
  nextPayment  DateTime?          @map("next_payment")
  graceEndsAt  DateTime?          @map("grace_ends_at")
  metadata     Json?              @map("metadata")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  workspace           Workspace   @relation("WorkspaceSubscriptions", fields: [workspaceId], references: [id], onDelete: Restrict)
  plan                Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  activeForWorkspaces Workspace[] @relation("WorkspaceActiveSubscription")

  @@index([workspaceId, status])
  @@index([planId])
  @@map("subscriptions")
}

