model Workspace {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  slug                String          @unique
  companyName         String?         @map("company_name")
  ownerId             String?         @map("owner_user_id") @db.Uuid
  logoUrl             String?         @map("logo_url")
  primaryColor        String?         @map("primary_color")
  secondaryColor      String?         @map("secondary_color")
  country             String?
  language            String          @default("en")
  timezone            String          @default("UTC")
  currency            String          @default("USD")
  subscriptionId      String?         @map("subscription_id") @db.Uuid
  planId              String?         @map("plan_id") @db.Uuid
  status              WorkspaceStatus @default(ACTIVE)
  maxUsers            Int             @default(0) @map("max_users")
  maxAgents           Int             @default(0) @map("max_agents")
  maxMessages         Int             @default(0) @map("max_messages")
  maxStorage          BigInt          @default(0) @map("max_storage")
  maxTokens           Int             @default(0) @map("max_tokens")
  currentStorageUsage BigInt          @default(0) @map("current_storage_usage")
  currentTokenUsage   Int             @default(0) @map("current_token_usage")
  permissionRevision  Int             @default(0) @map("permission_revision")
  aiEnabled           Boolean         @default(true) @map("ai_enabled")
  whatsappEnabled     Boolean         @default(false) @map("whatsapp_enabled")
  emailEnabled        Boolean         @default(false) @map("email_enabled")
  apiEnabled          Boolean         @default(false) @map("api_enabled")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")

  owner              User?               @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activeSubscription Subscription?       @relation("WorkspaceActiveSubscription", fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan               Plan?               @relation("WorkspacePlan", fields: [planId], references: [id], onDelete: SetNull)
  users              User[]              @relation("WorkspaceUsers")
  roles              Role[]
  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]
  agents             AiAgent[]
  knowledgeBases     KnowledgeBase[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeCollections KnowledgeCollection[]
  knowledgeFolders     KnowledgeFolder[]
  knowledgeCategories  KnowledgeCategory[]
  knowledgeTags        KnowledgeTag[]
  knowledgeChunks      KnowledgeChunkMetadata[]
  toolCategories       ToolCategory[]
  toolGroups           ToolGroup[]
  toolDefinitions      ToolDefinition[]
  workflows            Workflow[]
  workflowCategories   WorkflowCategory[]
  workflowTags         WorkflowTag[]
  executionProfiles    ExecutionProfile[]
  queueDefinitions     QueueDefinition[]
  executionPriorities  ExecutionPriorityLevel[]
  executionTags        ExecutionTag[]
  executionRequests    ExecutionRequest[]
  executionRuns        ExecutionRun[]
  executionSteps       ExecutionStep[]
  executionEvents      ExecutionEvent[]
  executionLogs        ExecutionLog[]
  agentRuntimePreparations AgentRuntimePreparation[]
  agentRuntimeSnapshots    AgentRuntimeSnapshot[]
  agentRuntimeConversations AgentRuntimeConversation[]
  compiledPrompts          CompiledPrompt[]
  promptExecutionPayloads  PromptExecutionPayload[]
  providerRuntimeRequests  ProviderRuntimeRequest[]
  providerRequestSnapshots ProviderRequestSnapshot[]
  retrievalRuntimes        RetrievalRuntime[]
  retrievalRuntimeSnapshots RetrievalRuntimeSnapshot[]
  conversationRuntimes      ConversationRuntime[]
  conversationRuntimeSnapshots ConversationRuntimeSnapshot[]
  executionPipelines           ExecutionPipeline[]
  executionPipelineSnapshots   ExecutionPipelineSnapshot[]
  agentExecutionOrchestrations AgentExecutionOrchestration[]
  runtimeOptimizationPackages  RuntimeOptimizationPackage[]
  runtimeOptimizationProviderOutcomes RuntimeOptimizationProviderOutcome[]
  streamSessions               StreamSession[]
  memoryRuntimes               MemoryRuntime[]
  memoryRuntimeSnapshots       MemoryRuntimeSnapshot[]
  subscriptions      Subscription[]      @relation("WorkspaceSubscriptions")
  payments           Payment[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  usageStatistics    UsageStatistic[]
  featureFlags       FeatureFlag[]
  permissionOverrides WorkspacePermissionOverride[]
  userPermissionOverrides UserPermissionOverride[]
  temporaryRoleAssignments TemporaryRoleAssignment[]
  temporaryPermissionAssignments TemporaryPermissionAssignment[]
  branding           WorkspaceBranding?
  platformManifest   WorkspacePlatformManifest?
  memberships        WorkspaceMembership[]
  invitations        WorkspaceInvitation[]
  aiProviderCredentials    AiProviderCredential[]
  aiProviderConfigurations AiProviderConfiguration[]
  aiProviderHealthRecords  AiProviderHealthRecord[]
  aiInvocations            AiInvocationLog[]
  aiUsageRecords           AiUsageRecord[]
  aiCostRecords            AiCostRecord[]
  aiPromptTemplates        AiPromptTemplate[]
  aiMemoryRecords          AiMemoryRecord[]
  aiRoutingMetadata        AiRoutingMetadata[]
  aiCacheMetadata          AiCacheMetadata[]
  aiRuntimeLimit           AiWorkspaceRuntimeLimit?
  aiRuntimeReservations    AiRuntimeReservation[]
  aiRuntimeAccounting      AiRuntimeAccounting[]
  aiRuntimeFinalizations   AiRuntimeFinalization[]
  studioProjects           StudioProject[]
  promptCategories         PromptCategory[]
  promptTags               PromptTag[]
  promptLibraryItems       PromptLibraryItem[]

  @@index([status])
  @@index([createdAt])
  @@map("workspaces")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  workspaceId   String     @map("workspace_id") @db.Uuid
  firstName     String?    @map("first_name")
  lastName      String?    @map("last_name")
  fullName      String     @map("full_name")
  email         String
  passwordHash  String     @map("password_hash")
  phone         String?
  avatar        String?
  roleId        String?    @map("role_id") @db.Uuid
  departmentId  String?    @map("department_id") @db.Uuid
  status        UserStatus @default(INVITED)
  language      String     @default("en")
  timezone      String     @default("UTC")
  lastLoginAt   DateTime?  @map("last_login")
  emailVerified Boolean    @default(false) @map("email_verified")
  mfaEnabled    Boolean    @default(false) @map("mfa_enabled")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  workspace             Workspace           @relation("WorkspaceUsers", fields: [workspaceId], references: [id], onDelete: Restrict)
  role                  Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  ownedWorkspaces       Workspace[]         @relation("WorkspaceOwner")
  assignedCustomers     Customer[]          @relation("CustomerAssignee")
  assignedConversations Conversation[]      @relation("ConversationAssignee")
  uploadedDocuments     KnowledgeDocument[] @relation("DocumentUploader")
  auditLogs             AuditLog[]
  notifications         Notification[]
  sessions              Session[]
  memberships           WorkspaceMembership[]
  receivedInvitations   WorkspaceInvitation[] @relation("InvitationTarget")
  sentInvitations       WorkspaceInvitation[] @relation("InvitationInviter")
  temporaryRoleAssignments TemporaryRoleAssignment[]
  temporaryPermissionAssignments TemporaryPermissionAssignment[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model WorkspaceMembership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  roleId      String           @map("role_id") @db.Uuid
  status      MembershipStatus @default(INVITED)
  invitedAt   DateTime         @default(now()) @map("invited_at")
  acceptedAt  DateTime?        @map("accepted_at")
  suspendedAt DateTime?        @map("suspended_at")
  removedAt   DateTime?        @map("removed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([userId, workspaceId, status])
  @@map("workspace_users")
}

model WorkspaceInvitation {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  membershipId    String   @map("membership_id") @db.Uuid
  targetUserId    String   @map("target_user_id") @db.Uuid
  invitedByUserId String   @map("invited_by_user_id") @db.Uuid
  tokenHash       String   @unique @map("token_hash")
  expiresAt       DateTime @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  rejectedAt      DateTime? @map("rejected_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  targetUser User                @relation("InvitationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  invitedBy  User                @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, expiresAt])
  @@index([membershipId, createdAt])
  @@index([targetUserId, expiresAt])
  @@map("workspace_invitations")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  deviceName       String?   @map("device_name")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([workspaceId, expiresAt])
  @@map("sessions")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  name        String
  description String?
  priority    Int       @default(0)
  systemRole  Boolean   @default(false) @map("system_role")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]
  memberships     WorkspaceMembership[]
  inheritedRoles  RoleInheritance[] @relation("RoleInheritanceChild")
  parentRoles     RoleInheritance[] @relation("RoleInheritanceParent")
  temporaryAssignments TemporaryRoleAssignment[]

  @@unique([workspaceId, name])
  @@index([workspaceId, priority])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  groupId     String?  @map("permission_group_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  group           PermissionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  inheritedPermissions PermissionInheritance[] @relation("PermissionInheritanceChild")
  parentPermissions    PermissionInheritance[] @relation("PermissionInheritanceParent")
  workspaceOverrides   WorkspacePermissionOverride[]
  userOverrides        UserPermissionOverride[]
  temporaryAssignments TemporaryPermissionAssignment[]

  @@index([groupId])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  fullName        String    @map("full_name")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  phone           String?
  email           String?
  country         String?
  city            String?
  language        String?   @default("en")
  gender          String?
  birthDate       DateTime? @map("birth_date") @db.Date
  notes           String?
  leadScore       Int       @default(0) @map("lead_score")
  pipelineStageId String?   @map("pipeline_stage_id") @db.Uuid
  assignedUserId  String?   @map("assigned_user_id") @db.Uuid
  aiSummary       String?   @map("ai_summary")
  sentimentScore  Decimal?  @map("sentiment_score") @db.Decimal(5, 2)
  tags            String[]  @default([])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  assignedUser  User?          @relation("CustomerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  messages      Message[]
  workflowRuns  WorkflowRun[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, phone])
  @@index([workspaceId, email])
  @@index([assignedUserId])
  @@map("customers")
}

model Conversation {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  customerId      String               @map("customer_id") @db.Uuid
  assignedUserId  String?              @map("assigned_user_id") @db.Uuid
  assignedAgentId String?              @map("assigned_agent_id") @db.Uuid
  channel         ConversationChannel
  status          ConversationStatus   @default(OPEN)
  priority        ConversationPriority @default(NORMAL)
  language        String?              @default("en")
  startedAt       DateTime             @default(now()) @map("started_at")
  closedAt        DateTime?            @map("closed_at")
  totalMessages   Int                  @default(0) @map("total_messages")
  aiMessages      Int                  @default(0) @map("ai_messages")
  humanMessages   Int                  @default(0) @map("human_messages")
  totalTokens     Int                  @default(0) @map("total_tokens")
  totalCost       Decimal              @default(0) @map("total_cost") @db.Decimal(14, 6)
  sentiment       String?
  summary         String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser  User?         @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAgent AiAgent?      @relation("ConversationAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      Message[]
  workflowRuns  WorkflowRun[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([customerId, workspaceId])
  @@index([assignedUserId])
  @@index([assignedAgentId])
  @@map("conversations")
}

model Message {
  id                String        @id @default(uuid()) @db.Uuid
  conversationId    String        @map("conversation_id") @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  senderType        SenderType    @map("sender_type")
