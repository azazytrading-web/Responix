  applicationId          String                  @db.Uuid
  tenantId               String?                 @db.Uuid
  actorPrincipalId       String?                 @db.Uuid
  sessionId              String?                 @db.VarChar(128)
  kind                   OicMemoryKind
  lifecycle              OicMemoryLifecycle      @default(UNVERIFIED)
  sensitivity            OicMemorySensitivity    @default(INTERNAL)
  title                  String                  @db.VarChar(240)
  content                String                  @db.Text
  embedding              Float[]                 @default([])
  embeddingModel         String                  @default("hashed-token-ngram-v1") @db.VarChar(64)
  embeddingDimensions    Int                     @default(384)
  entityKey              String?                 @db.VarChar(160)
  sourceType             String                  @db.VarChar(64)
  sourceRef              String?                 @db.VarChar(256)
  confidence              Int                     @default(50)
  salience                Int                     @default(50)
