model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  billingCycle BillingCycle       @map("billing_cycle")
  status       SubscriptionStatus @default(TRIAL)
  startedAt    DateTime           @map("started_at")
  expiresAt    DateTime?          @map("expires_at")
  autoRenew    Boolean            @default(false) @map("auto_renew")
  nextPayment  DateTime?          @map("next_payment")
  graceEndsAt  DateTime?          @map("grace_ends_at")
  metadata     Json?              @map("metadata")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  workspace           Workspace   @relation("WorkspaceSubscriptions", fields: [workspaceId], references: [id], onDelete: Restrict)
  plan                Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  activeForWorkspaces Workspace[] @relation("WorkspaceActiveSubscription")

  @@index([workspaceId, status])
  @@index([planId])
  @@map("subscriptions")
}

