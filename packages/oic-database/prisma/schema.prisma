  expiresAt             DateTime                  @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  admission             OicAdmission              @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  bucket                OicQuotaBucket            @relation(fields: [bucketId], references: [id], onDelete: Restrict)
  quotaPolicy           OicQuotaPolicyRevision?   @relation(fields: [quotaPolicyRevisionId], references: [id], onDelete: Restrict)
  budgetPolicy          OicBudgetRevision?        @relation(fields: [budgetRevisionId], references: [id], onDelete: Restrict)
  @@unique([admissionId, bucketId])
  @@index([bucketId, state, expiresAt])
  @@index([admissionId, state])
}

model OicUsagePosting {
  id             String               @id @default(uuid()) @db.Uuid
  bucketId       String               @db.Uuid
  admissionId    String?              @db.Uuid
  sourceKey      String               @db.VarChar(160)
  kind           OicUsagePostingKind
  amount         Decimal              @db.Decimal(38, 18)
  sequence       Int
  recordedAt     DateTime             @default(now()) @db.Timestamptz(6)
  bucket         OicQuotaBucket       @relation(fields: [bucketId], references: [id], onDelete: Restrict)
  admission      OicAdmission?        @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  @@unique([bucketId, sourceKey, kind])
  @@unique([bucketId, sequence])
  @@index([bucketId, recordedAt, id])
}

model OicApplicationModelVisibility {
  id            String          @id @default(uuid()) @db.Uuid
