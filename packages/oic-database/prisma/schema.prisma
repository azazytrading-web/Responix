model OicIntelligenceExecution {
  id                 String            @id @default(uuid()) @db.Uuid
  traceId            String            @unique @db.VarChar(128)
  requestId          String            @db.VarChar(128)
  applicationId      String            @db.Uuid
  tenantId           String?           @db.Uuid
  principalId        String             @db.Uuid
  modelId            String             @db.VarChar(64)
  modelRevisionId    String?            @db.Uuid
  profileRevisionId  String?            @db.Uuid
  status             OicExecutionStatus @default(RUNNING)
  strategy           String             @db.VarChar(64)
  taskType           String             @db.VarChar(64)
  uncertainty        String             @db.VarChar(32)
  stageCount         Int                @default(0)
  providerCallCount  Int                @default(0)
  retrievalQueryCount Int               @default(0)
  memoryLookupCount  Int                @default(0)
  contextTokens      Int                @default(0)
  inputTokens        Int?
  outputTokens       Int?
  verificationStatus String             @db.VarChar(32)
  summary            Json
  startedAt          DateTime           @default(now()) @db.Timestamptz(6)
  completedAt        DateTime?          @db.Timestamptz(6)
  application        OicApplication     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
